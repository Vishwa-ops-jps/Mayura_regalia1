# Copy the lines you need into backend/.env (never commit real passwords).
# --- Order emails (optional; leave blank to keep emails off) ---
# Gmail example: turn on 2-step verification, create an "App password", use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Mayura Regalia" <yourstore@gmail.com>
# Shown in the email footer and used for the "Track your order" button:
SUPPORT_EMAIL=support@mayuraregalia.com
SUPPORT_PHONE=8951084668
FRONTEND_URL=http://localhost:3000
