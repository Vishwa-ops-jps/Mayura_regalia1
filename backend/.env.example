# Copy the lines you need into backend/.env (never commit real passwords).
# --- Database SSL (e.g. Aiven MySQL) ---
# Set DB_SSL=true and provide the CA certificate in one of two ways:
#   DB_SSL_CA      PEM contents of the CA certificate (literal \n sequences are converted to newlines)
#   DB_SSL_CA_PATH path to a CA certificate file (defaults to backend/certs/Aiven.pem if it exists)
# DB_SSL_CA takes precedence if both are set.
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_CA_PATH=
# --- Order emails (optional; leave blank to keep emails off) ---
# Gmail example: turn on 2-step verification, create an "App password", use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Mayura Regalia" <yourstore@gmail.com>
# Shown in the email footer and used for the "Track your order" button:
SUPPORT_EMAIL=support@mayuraregalia.com
SUPPORT_PHONE=8951084668
FRONTEND_URL=http://localhost:3000
